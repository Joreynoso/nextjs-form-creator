name: Release Please (Simplified)

on:
  push:
    branches:
      - master   # o master según tu repo

permissions:
  contents: write
  pull-requests: write

jobs:
  release-please:
    runs-on: ubuntu-latest
    name: Create Release PR and AI Notes
    steps:
      # Crea un PR de release, sin mergear ni publicar release
      - uses: googleapis/release-please-action@v4
        id: release
        with:
          target-branch: main
          release-type: node
          create-release: false   # evita merge/release automático

      # Generar notas de release con IA y comentarlas en el PR
      - name: Generate AI Release Notes
        if: ${{ steps.release.outputs.pull_request_url }}
        uses: actions/github-script@v7
        env:
          GEMINI_API_KEY: ${{ secrets.GEMINI_API_KEY }}
          SYSTEM_PROMPT: |
            Eres un redactor técnico experto. Genera notas de release en castellano basadas en los cambios.
            Incluye:
            - Resumen breve
            - Funcionalidades
            - Correcciones de bugs
            - Otros cambios
        with:
          script: |
            const prUrl = '${{ steps.release.outputs.pull_request_url }}'
            const releaseBody = `${{ steps.release.outputs.body }}`
            
            if (!process.env.GEMINI_API_KEY) {
              console.warn("⚠️ GEMINI_API_KEY no encontrado. Notas estándar.")
              return
            }

            try {
              const response = await fetch(
                `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${process.env.GEMINI_API_KEY}`,
                {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({
                    system_instruction: { parts: [{ text: process.env.SYSTEM_PROMPT }] },
                    contents: [{ 
                      role: 'user', 
                      parts: [{ text: `Genera notas de release para la versión basada en estos cambios:\n\n${releaseBody}` }] 
                    }]
                  })
                }
              )

              if (!response.ok) throw new Error(`API Error: ${response.statusText}`)

              const data = await response.json()
              const aiNotes = data.candidates[0].content.parts[0].text

              console.log("✅ Notas generadas por IA:\n", aiNotes)

              const prNumber = parseInt(prUrl.split('/').pop())
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: prNumber,
                body: `### Notas de release (IA)\n\n${aiNotes}`
              })

            } catch (error) {
              console.error("❌ Error generando notas de IA:", error)
            }
